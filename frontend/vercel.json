{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!assets/|icons/|models/|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/models/(.*)\\.onnx",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
