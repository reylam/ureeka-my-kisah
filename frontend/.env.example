# Browser-safe settings only. Copy to `.env` (git-ignored).
# Everything prefixed VITE_ is bundled into the app and visible to every visitor.

# PARUPINTAS backend, including the version prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase project (Settings -> API). For `supabase start`, run `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The PUBLIC anon key. NEVER put the service-role key here.
VITE_SUPABASE_ANON_KEY=replace-with-the-anon-key
