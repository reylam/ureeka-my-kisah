{
  "name": "parupintas-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PARUPINTAS API: Express + Supabase (Postgres, Auth, RLS, Storage)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\" \"tests/e2e/*.test.js\"",
    "test:browser": "node --test tests/browser/ui.test.js",
    "provision": "node scripts/provision-user.js",
    "e2e:setup": "node scripts/setup-postgrest.js",
    "dev:local": "node scripts/local-stack.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "playwright-core": "1.64.1"
  }
}
