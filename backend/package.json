{
  "name": "pulmo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PULMO API: Express + Supabase (Postgres, Auth, RLS, Storage)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/",
    "provision": "node scripts/provision-user.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10"
  }
}
