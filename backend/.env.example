# PARUPINTAS backend environment.
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.

NODE_ENV=development
PORT=4000

# Supabase project (Settings -> API). For `supabase start`, run `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-the-anon-key
# SERVER ONLY. Bypasses Row Level Security. Never put this in the frontend,
# never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Browser origin(s) allowed to call this API, comma separated, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy / load balancer so rate
# limiting sees the real client address.
TRUST_PROXY=false

# Private storage bucket for chest X-rays (created by the migrations).
STORAGE_BUCKET=screening-images
MAX_UPLOAD_MB=15
SIGNED_URL_TTL_SECONDS=60

# Optional. Full URL of the Python inference endpoint that accepts a multipart
# `image` field (inference/serve.py in this repository serves exactly that, on
# http://127.0.0.1:8000/predict). Leave empty and analysis answers 503 "model not
# connected"; nothing is simulated.
INFERENCE_SERVICE_URL=
# Bearer token the inference service requires (train/tb-train: python -m tb_ai.serve --api-key ...).
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_MS=60000
